---
// Trazas de circuito decorativas con pulsos lentos. Van detrás del contenido con la clase .decor.
interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;
const traces = [
  'M600 60 H460 L420 100 H300',
  'M600 140 H520 L480 180 H360 V250 H260',
  'M600 300 H500 L460 340 H380',
  'M440 0 V40 L400 80 V120',
];
const pulseColors = ['var(--color-neon)', 'var(--color-amber)', 'var(--color-hot)', 'var(--color-neon)'];
const nodes: [number, number][] = [
  [300, 100],
  [260, 250],
  [380, 340],
  [400, 120],
];
---

<svg viewBox="0 0 600 400" class={cls} fill="none" aria-hidden="true" preserveAspectRatio="xMaxYMid slice">
  <g stroke="currentColor" stroke-width="1.2" opacity="0.22">
    {traces.map((d) => <path d={d} />)}
  </g>
  <g stroke-width="1.8" stroke-linecap="round" opacity="0.75">
    {traces.map((d, i) => (
      <path d={d} pathLength="200" class="trace-pulse" stroke={pulseColors[i % pulseColors.length]} style={`animation-delay:-${i * 2.3}s`} />
    ))}
  </g>
  <g stroke="currentColor" stroke-width="1.2" opacity="0.4" fill="none">
    {nodes.map(([x, y]) => <circle cx={x} cy={y} r="3.5" />)}
  </g>
</svg>
