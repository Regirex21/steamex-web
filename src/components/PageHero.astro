---
import Gear from './Gear.astro';
import CircuitBg from './CircuitBg.astro';
import ChevronRow from './ChevronRow.astro';
interface Props {
  tag?: string;
  title: string;
  lead?: string;
}
const { tag, title, lead } = Astro.props;
---

<section class="surface-hero border-b border-line">
  <CircuitBg class="decor decor-right right-0 top-0 h-full w-[55%]" />
  <Gear class="decor spin-slow -right-28 top-1/2 h-[24rem] w-[24rem] -translate-y-1/2 opacity-[0.07]" />
  <div class="mx-auto max-w-6xl px-5 py-16 md:py-24">
    {tag && <p class="tag flex items-center gap-3"><ChevronRow /><span class="cursor">{tag.replace(/^\/\/\s*/, '')}</span></p>}
    <h1 class="mt-5 max-w-3xl text-4xl font-extrabold md:text-5xl">{title}</h1>
    {lead && <p class="mt-6 max-w-2xl text-xl text-muted">{lead}</p>}
    <div class="mt-9 flex flex-wrap gap-4 empty:hidden"><slot /></div>
  </div>
</section>
