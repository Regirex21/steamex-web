---
// Robot 3D animado (brazo sobre base swerve). Si el navegador no soporta WebGL, se queda el dibujo SVG.
import RobotArm from './RobotArm.astro';
interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;
---

<div class={`robot3d relative aspect-square ${cls}`} data-robot3d>
  <div class="robot3d-fallback absolute inset-0"><RobotArm class="h-full w-full" /></div>
  <canvas class="absolute inset-0 h-full w-full" aria-hidden="true"></canvas>
  <div data-overlay class="pointer-events-none absolute inset-0 font-[family-name:var(--font-mono)] text-[11px] tracking-wider" aria-hidden="true">
    <span class="absolute left-0 top-0 leading-relaxed">
      <span class="block text-neon">SYS // ONLINE</span>
      <span class="block text-amber">SWERVE 4/4 MÓDULOS</span>
    </span>
  </div>
  <p class="sr-only">Ilustración animada de un robot con base swerve y brazo articulado que sostiene una pieza de juego.</p>
</div>

<script>
  import { initRobot } from '../scripts/robot3d.js';
  document.querySelectorAll<HTMLElement>('[data-robot3d]').forEach((el) => initRobot(el));
</script>

<style>
  .robot3d .robot3d-fallback {
    transition: opacity 0.3s;
  }
  .robot3d canvas,
  .robot3d [data-overlay] {
    opacity: 0;
    transition: opacity 0.6s;
  }
  .robot3d.is-3d .robot3d-fallback {
    opacity: 0;
    pointer-events: none;
  }
  .robot3d.is-3d canvas,
  .robot3d.is-3d [data-overlay] {
    opacity: 1;
  }
</style>
